# 1. Database (Neon Serverless PostgreSQL - Free Tier)
DATABASE_URL="postgresql://user:password@ep-cool-darkness-123456.us-east-2.aws.neon.tech/meterflow?sslmode=require"

# 2. Authentication (Better-Auth)
BETTER_AUTH_SECRET="replace-with-32-byte-hex-secret-generated-via-openssl"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. Upstash Redis (Free Tier - Optional in dev: auto-falls back to In-Memory Lua Emulator)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# 4. Stripe Billing (Test Mode - Optional in dev: auto-falls back to Mock Stripe Adapter)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# 5. Google Gemini AI Studio (Free Tier - Optional in dev: auto-falls back to Heuristic SQL Builder)
GEMINI_API_KEY=""

# 6. Inngest Background Workers (Local Dev Server works with zero keys)
INNGEST_EVENT_KEY="local"
INNGEST_SIGNING_KEY=""

# 7. Resend Email (Free Tier - Optional)
RESEND_API_KEY=""